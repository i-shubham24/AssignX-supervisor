# Demo mode (built-in sample data, open segment picker on sign-in):
# - development: on unless VITE_DEMO_MODE=false (or run `npm run dev:live`)
# - production builds: OFF unless VITE_DEMO_MODE=true. Never set true on the real portal.
VITE_DEMO_MODE=
# Publishable key only. Privileged keys bypass row level security and are refused at boot.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
