{
  "name": "assignx-supervisor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3200",
    "dev:live": "vite --mode live --host 127.0.0.1 --port 3200",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --mode demo",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "check:secrets": "node scripts/secret-scan.mjs",
    "check:copy": "node scripts/copy-guard.mjs",
    "check:security": "node scripts/security-scan.mjs",
    "check:dist": "node scripts/dist-scan.mjs",
    "test:routes": "node scripts/qa-phase1-routes.mjs",
    "test:workflows": "node scripts/run-ts.mjs scripts/qa-phase2-workflows.ts",
    "test:responsive": "node scripts/qa-phase3-responsive.mjs",
    "test:webhooks": "node scripts/qa-phase4-webhooks.mjs",
    "test:security": "node scripts/run-ts.mjs scripts/qa-phase5-security-matrix.ts",
    "test:middleware": "node scripts/qa-phase6-middleware-contract.mjs",
    "audit": "npm audit --omit=dev --audit-level=moderate",
    "verify": "npm run typecheck && npm run lint && npm run check:secrets && npm run check:copy && npm run check:security && npm run test:routes && npm run test:workflows && npm run test:responsive && npm run test:webhooks && npm run test:security && npm run test:middleware && npm run build:demo && npm run check:dist"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.102.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^13.3.0",
    "lucide-react": "^0.544.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router-dom": "^7.18.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.3.7"
  }
}
